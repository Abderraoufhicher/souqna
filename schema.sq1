-- SOUQNA marketplace schema for Supabase (PostgreSQL)
-- Apply only after creating a Supabase project and reviewing the RLS policies.
create extension if not exists pgcrypto;
create type public.account_role as enum ('merchant','individual');
create type public.product_status as enum ('draft','active','hidden','deleted');

create table public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  full_name text not null,
  phone text,
  role public.account_role not null default 'individual',
  wilaya text,
  preferred_language text not null default 'ar' check (preferred_language in ('ar','fr')),
  preferred_theme text not null default 'light' check (preferred_theme in ('light','dark')),
  created_at timestamptz not null default now()
);
create table public.stores (
  id uuid primary key default gen_random_uuid(),
  owner_id uuid not null unique references public.profiles(id) on delete cascade,
  name text not null,
  slug text not null unique,
  description text,
  category text not null,
  wilaya text not null,
  municipality text,
  logo_path text,
  cover_path text,
  phone text,
  whatsapp text,
  verified_at timestamptz,
  delivery_wilayas text[] not null default '{}',
  delivery_fee numeric(12,2) not null default 0,
  pickup_available boolean not null default true,
  cash_on_delivery boolean not null default true,
  created_at timestamptz not null default now()
);
create table public.products (
  id uuid primary key default gen_random_uuid(),
  store_id uuid not null references public.stores(id) on delete cascade,
  name text not null,
  description text,
  category text not null,
  price numeric(14,2) not null check (price >= 0),
  currency text not null default 'DZD',
  wilaya text,
  municipality text,
  status public.product_status not null default 'draft',
  stock_quantity integer,
  is_featured boolean not null default false,
  discount_price numeric(14,2),
  phone text,
  whatsapp text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create table public.product_images (
  id uuid primary key default gen_random_uuid(),
  product_id uuid not null references public.products(id) on delete cascade,
  storage_path text not null,
  sort_order integer not null default 0
);
create table public.favorites (
  user_id uuid not null references public.profiles(id) on delete cascade,
  product_id uuid not null references public.products(id) on delete cascade,
  created_at timestamptz not null default now(),
  primary key(user_id,product_id)
);
create table public.store_follows (
  user_id uuid not null references public.profiles(id) on delete cascade,
  store_id uuid not null references public.stores(id) on delete cascade,
  created_at timestamptz not null default now(),
  primary key(user_id,store_id)
);
create table public.conversations (
  id uuid primary key default gen_random_uuid(),
  store_id uuid not null references public.stores(id) on delete cascade,
  customer_id uuid not null references public.profiles(id) on delete cascade,
  created_at timestamptz not null default now(),
  unique(store_id,customer_id)
);
create table public.messages (
  id uuid primary key default gen_random_uuid(),
  conversation_id uuid not null references public.conversations(id) on delete cascade,
  sender_id uuid not null references public.profiles(id) on delete cascade,
  body text not null,
  created_at timestamptz not null default now(),
  read_at timestamptz
);
create table public.reviews (
  id uuid primary key default gen_random_uuid(),
  store_id uuid not null references public.stores(id) on delete cascade,
  reviewer_id uuid not null references public.profiles(id) on delete cascade,
  rating integer not null check (rating between 1 and 5),
  body text,
  created_at timestamptz not null default now(),
  unique(store_id,reviewer_id)
);
create table public.quote_requests (
  id uuid primary key default gen_random_uuid(),
  requester_id uuid references public.profiles(id) on delete set null,
  name text not null,
  phone text not null,
  company text,
  wilaya text not null,
  details text not null,
  status text not null default 'open',
  created_at timestamptz not null default now()
);
create table public.quote_responses (
  id uuid primary key default gen_random_uuid(),
  quote_request_id uuid not null references public.quote_requests(id) on delete cascade,
  supplier_store_id uuid not null references public.stores(id) on delete cascade,
  amount numeric(14,2),
  details text,
  delivery_cost numeric(14,2),
  created_at timestamptz not null default now()
);
create table public.ad_campaigns (
  id uuid primary key default gen_random_uuid(),
  store_id uuid not null references public.stores(id) on delete cascade,
  product_id uuid references public.products(id) on delete cascade,
  status text not null default 'pending',
  starts_at timestamptz,
  ends_at timestamptz,
  payment_reference text,
  created_at timestamptz not null default now()
);
create table public.product_events (
  id bigint generated always as identity primary key,
  product_id uuid not null references public.products(id) on delete cascade,
  event_type text not null check (event_type in ('view','contact','favorite','share')),
  visitor_id uuid references public.profiles(id) on delete set null,
  created_at timestamptz not null default now()
);

-- Enable RLS on every table.
do $$ declare t text; begin
  foreach t in array array['profiles','stores','products','product_images','favorites','store_follows','conversations','messages','reviews','quote_requests','quote_responses','ad_campaigns','product_events'] loop
    execute format('alter table public.%I enable row level security',t);
  end loop;
end $$;

-- Profiles: users can read public profile fields and update only their own row.
create policy "profile owner read" on public.profiles for select using (auth.uid() = id);
create policy "profile owner insert" on public.profiles for insert with check (auth.uid() = id);
create policy "profile owner update" on public.profiles for update using (auth.uid() = id) with check (auth.uid() = id);
-- Stores: public storefronts; only the owner may create/change their store.
create policy "stores public read" on public.stores for select using (true);
create policy "store owner insert" on public.stores for insert with check (auth.uid() = owner_id);
create policy "store owner update" on public.stores for update using (auth.uid() = owner_id) with check (auth.uid() = owner_id);
create policy "store owner delete" on public.stores for delete using (auth.uid() = owner_id);
-- Products: active products are public; store owner controls their inventory.
create policy "active products public read" on public.products for select using (status = 'active' or exists(select 1 from public.stores s where s.id=store_id and s.owner_id=auth.uid()));
create policy "product owner insert" on public.products for insert with check (exists(select 1 from public.stores s where s.id=store_id and s.owner_id=auth.uid()));
create policy "product owner update" on public.products for update using (exists(select 1 from public.stores s where s.id=store_id and s.owner_id=auth.uid())) with check (exists(select 1 from public.stores s where s.id=store_id and s.owner_id=auth.uid()));
create policy "product owner delete" on public.products for delete using (exists(select 1 from public.stores s where s.id=store_id and s.owner_id=auth.uid()));
create policy "product images public read" on public.product_images for select using (true);
create policy "product images owner write" on public.product_images for all using (exists(select 1 from public.products p join public.stores s on s.id=p.store_id where p.id=product_id and s.owner_id=auth.uid())) with check (exists(select 1 from public.products p join public.stores s on s.id=p.store_id where p.id=product_id and s.owner_id=auth.uid()));
create policy "favorites owner all" on public.favorites for all using (auth.uid()=user_id) with check (auth.uid()=user_id);
create policy "follows owner all" on public.store_follows for all using (auth.uid()=user_id) with check (auth.uid()=user_id);
-- Conversation membership: customer or store owner only.
create policy "conversation members read" on public.conversations for select using (auth.uid()=customer_id or exists(select 1 from public.stores s where s.id=store_id and s.owner_id=auth.uid()));
create policy "customer creates conversation" on public.conversations for insert with check (auth.uid()=customer_id);
create policy "conversation members read messages" on public.messages for select using (exists(select 1 from public.conversations c left join public.stores s on s.id=c.store_id where c.id=conversation_id and (c.customer_id=auth.uid() or s.owner_id=auth.uid())));
create policy "conversation members send messages" on public.messages for insert with check (auth.uid()=sender_id and exists(select 1 from public.conversations c left join public.stores s on s.id=c.store_id where c.id=conversation_id and (c.customer_id=auth.uid() or s.owner_id=auth.uid())));
create policy "reviews public read" on public.reviews for select using (true);
create policy "reviewer writes own review" on public.reviews for insert with check (auth.uid()=reviewer_id);
create policy "reviewer updates own review" on public.reviews for update using (auth.uid()=reviewer_id) with check (auth.uid()=reviewer_id);
create policy "quote requests owner read" on public.quote_requests for select using (requester_id is not null and auth.uid()=requester_id);
create policy "quote request create" on public.quote_requests for insert with check (requester_id is null or auth.uid()=requester_id);
create policy "quote response supplier read" on public.quote_responses for select using (exists(select 1 from public.stores s where s.id=supplier_store_id and s.owner_id=auth.uid()) or exists(select 1 from public.quote_requests q where q.id=quote_request_id and q.requester_id=auth.uid()));
create policy "supplier creates quote response" on public.quote_responses for insert with check (exists(select 1 from public.stores s where s.id=supplier_store_id and s.owner_id=auth.uid()));
create policy "campaign owner read" on public.ad_campaigns for select using (exists(select 1 from public.stores s where s.id=store_id and s.owner_id=auth.uid()));
create policy "campaign owner create" on public.ad_campaigns for insert with check (exists(select 1 from public.stores s where s.id=store_id and s.owner_id=auth.uid()));
create policy "product events insert" on public.product_events for insert with check (visitor_id is null or visitor_id=auth.uid());
create policy "store owner reads product events" on public.product_events for select using (exists(select 1 from public.products p join public.stores s on s.id=p.store_id where p.id=product_id and s.owner_id=auth.uid()));

-- Storage buckets: create 'store-assets' and 'product-images' as public buckets in Supabase Storage.
-- Add Storage policies separately after bucket creation; never expose service_role keys in browser code.

